# Persistence. Prisma resolves relative SQLite paths from prisma/, so ../db
# lands the file in db/ at the project root. Keeps the project portable.
DATABASE_URL=file:../db/custom.db

# Default: fully offline, deterministic, no external service required
DECISION_BACKEND=offline

# ---------------------------------------------------------------------------
# Backend 2: Laya (Convai Innovations, Apache-2.0), System One abierto.
# 421M sobre ModernBERT-large, entrenado con RLCD, ~33-40 ms por decision.
# Su servidor habla el MISMO contrato /v1/systemone que este proyecto.
#
#   pip install "laya[serve]"
#   laya-serve                      # 0.0.0.0:8000
#
# DECISION_BACKEND=laya
# DECISION_LAYA_URL=http://127.0.0.1:8000
# DECISION_LAYA_API_KEY=            # solo si arrancaste laya-serve con LAYA_API_KEY
# DECISION_LAYA_TIMEOUT_MS=30000
# ---------------------------------------------------------------------------

# Backend 3: cualquier endpoint compatible con OpenAI /chat/completions.
# DECISION_BACKEND=openai-compatible
# DECISION_MODEL_URL=http://localhost:11434/v1/chat/completions
# DECISION_MODEL_NAME=local-model
# DECISION_MODEL_API_KEY=
# DECISION_MODEL_TIMEOUT_MS=30000

# Optional application settings
PORT=3000

# DECISION_BACKEND=auto elige laya si hay DECISION_LAYA_URL, si no el modelo
# remoto, y si no el offline. Si el backend externo falla, la peticion cae al
# offline y la respuesta lo declara en el campo "backend".

# The offline provider is intentionally deterministic and auditable.
# It is not conscious and does not contain a universal model of reality.
